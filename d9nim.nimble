# Package

version       = "0.3.1"
author        = "SchelZ"
description   = "Direct3D 9 and D3DX 9 for Nim, in pure Nim (no C++ backend, no DirectX SDK), with a ready-made window and device loop"
license       = "GPL-3.0"
srcDir        = "src"

# Dependencies

requires "nim >= 2.0.0"
requires "winim >= 3.9.0"
